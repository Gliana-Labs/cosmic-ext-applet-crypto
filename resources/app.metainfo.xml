<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Zetakai.cosmic-ext-applet-crypto</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Crypto Ticker</name>
  <summary>Live cryptocurrency prices for the COSMIC™ desktop</summary>

  <!--
    Both spellings are deliberate. cosmic-store reads developer_name and nothing
    else: app_info.rs takes component.developer_name, and view.rs falls back to the
    "{app} Developers" string when it is empty, which is why this listing first
    showed "Crypto Prices Developers". Its appstream dependency is a fork
    (github.com/jackpot51/appstream), so the newer <developer><name> is not read
    there and dropping developer_name would silently break the listing again.

    <developer><name> is kept for everything else: upstream AppStream deprecated
    developer_name in 1.0 in favour of it.
  -->
  <developer_name>Gliana Labs</developer_name>
  <developer id="com.glianalabs">
    <name>Gliana Labs</name>
  </developer>

  <description>
    <p>
      Shows live cryptocurrency prices in the panel of the COSMIC™ desktop. The panel carries one
      coin's price at a glance; the popup lists every coin you track with its 24h
      change and a seven-day sparkline.
    </p>
    <p>Features:</p>
    <ul>
      <li>Track any coin listed on CoinGecko, added by ticker, name, or id</li>
      <li>Seven-day price sparkline on every row</li>
      <li>Prices in any fiat currency CoinGecko quotes</li>
      <li>Panel label detail is adjustable, down to an icon alone on vertical panels</li>
      <li>Prices are cached, so a restart shows the last known figures immediately</li>
      <li>No API key and no account required</li>
    </ul>
    <p>
      Price data comes from the CoinGecko public API. The applet contacts
      api.coingecko.com and nothing else.
    </p>
  </description>

  <launchable type="desktop-id">io.github.Zetakai.cosmic-ext-applet-crypto.desktop</launchable>

  <url type="homepage">https://github.com/Gliana-Labs/cosmic-ext-applet-crypto</url>
  <url type="bugtracker">https://github.com/Gliana-Labs/cosmic-ext-applet-crypto/issues</url>
  <url type="vcs-browser">https://github.com/Gliana-Labs/cosmic-ext-applet-crypto</url>

  <screenshots>
    <screenshot type="default">
      <caption>Tracked coins with their 24h change and seven-day trend</caption>
      <image>https://raw.githubusercontent.com/Gliana-Labs/cosmic-ext-applet-crypto/main/resources/screenshots/popup.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.2" date="2026-08-31">
      <description>
        <p>Renamed to Crypto Ticker. Hovering the panel icon now names the applet.</p>
      </description>
    </release>
    <release version="0.1.1" date="2026-08-29">
      <description>
        <p>Names Gliana Labs as the developer in the store listing.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-22">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>

  <provides>
    <id>com.system76.CosmicApplet</id>
    <binaries>
      <binary>cosmic-ext-applet-crypto</binary>
    </binaries>
  </provides>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <categories>
    <category>COSMIC</category>
  </categories>

  <keywords>
    <keyword>COSMIC</keyword>
    <keyword>crypto</keyword>
    <keyword>cryptocurrency</keyword>
    <keyword>bitcoin</keyword>
    <keyword>price</keyword>
  </keywords>

  <content_rating type="oars-1.1" />

  <!--
